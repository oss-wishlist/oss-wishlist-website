# Environment Variables
# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# Site Mode - Set to 'placeholder' to show coming soon page, 'full' for complete site
PUBLIC_SITE_MODE=full

# Base Path Configuration
# For GitHub Pages: '/oss-wishlist-website' 
# For root deployment (Digital Ocean, etc): '' (empty string)
PUBLIC_BASE_PATH=/oss-wishlist-website

# Site URL (without base path)
# Development: http://localhost:4321 (or your dev server port)
# Production: https://your-domain.com
PUBLIC_SITE_URL=http://localhost:4324
# Required: GitHub Personal Access Token
# Create one at: https://github.com/settings/tokens/new
# Needs 'repo' scope for creating issues
GITHUB_TOKEN=your_github_token_here

# GitHub OAuth Configuration (required for user authentication)
# Get these from: https://github.com/settings/developers
# IMPORTANT: Redirect URI should be {PUBLIC_SITE_URL}{PUBLIC_BASE_PATH}/auth/callback
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:4321/oss-wishlist-website/auth/callback

# GitLab OAuth Configuration (optional - for GitLab authentication)
# Get these from: https://gitlab.com/-/profile/applications (for GitLab.com)
# Or for self-hosted: https://your-gitlab-instance.com/-/profile/applications
# IMPORTANT: Redirect URI should be {PUBLIC_SITE_URL}{PUBLIC_BASE_PATH}/auth/callback (same as GitHub)
GITLAB_CLIENT_ID=your_gitlab_client_id_here
GITLAB_CLIENT_SECRET=your_gitlab_client_secret_here
GITLAB_REDIRECT_URI=http://localhost:4321/oss-wishlist-website/auth/callback
# For self-hosted GitLab instances, set this to your GitLab URL (default: https://gitlab.com)
GITLAB_BASE_URL=https://gitlab.com

# OAuth Security Secret (generate a random string with: openssl rand -hex 32)
# IMPORTANT: Use a strong random value in production
OAUTH_STATE_SECRET=your_random_secret_here_for_state_validation

# Who can reach /admin and the practitioner approval endpoints.
# Comma separated, as provider:username. A bare name means github.
# There is no default: leave this unset and nobody is an administrator.
# Name the provider. GitHub and GitLab have separate namespaces, so each
# account needs its own entry.
ADMIN_USERNAMES=github:your-github-username

# CA certificate for the managed Postgres cluster, so the connection is verified.
# DigitalOcean: Databases > your cluster > Connection Details > Download CA
# certificate. It is a public certificate, so committing it is fine. Put it at
# certs/do-postgres-ca.crt, set DATABASE_CA_CERT to its contents, or base64 the
# contents if the panel mangles multi-line values.
# Without it the connection stays encrypted and logs a warning at every start.
# DATABASE_CA_CERT_PATH=/etc/ssl/do-postgres-ca.crt

# Email settings (optional)
EMAIL_FROM=your_email_from@example.com
EMAIL_TO=your_email_to@example.com

# ===== CENTRALIZED EMAIL CONFIGURATION =====
# Used by all email features across the site

# Required: Admin email address (receives all admin notifications)
ADMIN_EMAIL=admin@example.com

# Email Provider: 'resend' | 'sendgrid' | 'console' (auto-detects if not set)
# Leave blank to auto-detect based on available API keys
EMAIL_PROVIDER=

# Sender Configuration
# Must be a verified domain with your email provider
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Email Provider API Keys (configure at least one for production)
# Resend: https://resend.com (recommended)
RESEND_API_KEY=re_your_api_key_here

# SendGrid: https://sendgrid.com (alternative)
SENDGRID_API_KEY=SG.your_api_key_here

# Note: Without an API key configured, emails will be logged to console (development only)
# ==========================================

# Staging/Production Environment Control
# Set to 'true' for staging to prevent search engine indexing
# Adds X-Robots-Tag header and disallows crawlers in robots.txt
# For production: omit this variable or set to 'false'
DISABLE_INDEXING=false

# Environment
NODE_ENV=development

# ---- Data refresh -------------------------------------------------------
# Contact address sent as ?mailto= to join the ecosyste.ms "polite pool".
# Set as a repository variable for the weekly refresh workflow, not committed.
ECOSYSTEMS_CONTACT=you@example.com

# ---- Local development only ---------------------------------------------
# Loads three clearly labelled preview practitioners so the practitioner
# surfaces can be seen without Postgres. Ignored whenever DATABASE_URL is set,
# so it cannot displace real practitioners in a deployment.
# PRACTITIONER_DEMO=1
