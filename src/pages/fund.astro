---
/**
 * /fund — browse critical packages worth sponsoring a service for.
 *
 * A fresh random set on every load, reshuffled by "show another set". There is
 * no ranking, no score, no leaderboard and no fixed order: no package sits above
 * another. Counts in the headline are computed from the data, never hand-edited,
 * and each one narrows the set rather than just stating a total.
 */
import Layout from '../components/Layout.astro';
import PackageGrid from '../components/PackageGrid.astro';
import DataAttribution from '../components/DataAttribution.astro';
import { getBasePath } from '../lib/paths';
import {
  samplePackages,
  presentPackage,
  getCounts,
  getPool,
  isFilterId,
  FILTERS,
} from '../lib/critical-packages';
import { SAMPLE_SIZE } from '../../config/data-sources.js';

export const prerender = false;

const basePath = getBasePath();
const counts = getCounts();

const requested = Astro.url.searchParams.get('flag');
const activeFilter = isFilterId(requested) ? requested : null;

const pool = getPool(activeFilter);
const packages = samplePackages(SAMPLE_SIZE, pool).map(presentPackage);

const fmt = (n: number) => n.toLocaleString('en-US');

/**
 * Each filter states its own count, and only appears when that count is above
 * zero. Some registries report no sole-maintainer data at all, so a filter built
 * blindly could offer "0 maintained by one person" — an empty number is an
 * argument against the point this page exists to make.
 */
const filters = FILTERS.map((f) => ({
  ...f,
  count: counts[f.id],
  active: activeFilter === f.id,
  href: activeFilter === f.id ? `${basePath}fund` : `${basePath}fund?flag=${f.id}`,
})).filter((f) => f.count > 0);

const activeLabel = filters.find((f) => f.active)?.label ?? null;
const hasContent = packages.length > 0;

const seeAllHref = activeFilter
  ? `${basePath}fund/all?flag=${activeFilter}`
  : `${basePath}fund/all`;
---

<Layout
  title="Sponsor a service | OSS Wishlist"
  description="Critical open source packages, and the services that might help the people maintaining them."
>
  <main class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-gray-900 mb-4">Sponsor a service</h1>

    <p class="text-lg text-gray-700 mb-2 max-w-3xl">
      {fmt(counts.total)} critical packages, as defined by ecosyste.ms.
    </p>

    <p class="text-gray-600 mb-6 max-w-3xl">
      Every one of these is associated with a rubric for verified impact, and expert
      practitioners in that area. Pick a package, choose the services that might help, and
      take the summary to whoever holds the budget.
    </p>

    {filters.length > 0 && (
      <div class="mb-8">
        <p class="text-sm font-semibold text-gray-700 mb-2">Narrow the set</p>
        <div class="flex flex-wrap gap-2">
          {filters.map((f) => (
            <a
              href={f.href}
              aria-pressed={f.active ? 'true' : 'false'}
              class={`text-sm px-3 py-1.5 rounded-full border transition-colors ${
                f.active
                  ? 'bg-gray-800 text-white border-gray-800 hover:bg-gray-700'
                  : 'bg-white text-gray-700 border-gray-300 hover:bg-gray-100'
              }`}
            >
              {f.label} <span class="opacity-70">{fmt(f.count)}</span>
              {f.active && <span aria-hidden="true"> &times;</span>}
            </a>
          ))}
        </div>

        {activeFilter === 'sole_maintainer' && (
          <p class="text-xs text-gray-500 mt-2 max-w-3xl">
            Counted across the {fmt(counts.with_maintainer_data)} packages we hold maintainer
            data for. Go and Maven have no registry maintainer accounts, so their packages
            cannot appear here either way.
          </p>
        )}
      </div>
    )}

    {hasContent ? (
      <>
        <p class="text-sm text-gray-600 mb-4">
          {activeLabel
            ? `A random set of ${packages.length} from the ${fmt(pool.length)} with ${activeLabel.toLowerCase()}.`
            : `A random set of ${packages.length}.`}
        </p>

        <div id="package-set">
          <PackageGrid packages={packages} />
        </div>

        <div class="flex flex-wrap items-center gap-4 mt-8">
          <button
            id="reshuffle"
            type="button"
            class="inline-flex items-center gap-2 bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700 transition-colors text-sm font-medium disabled:opacity-60"
          >
            Show another set
          </button>
          <a href={seeAllHref} class="text-sm text-gray-600 hover:text-gray-900 underline font-medium">
            See all {fmt(pool.length)} packages
          </a>
        </div>

        <p id="reshuffle-error" class="text-sm text-gray-600 mt-3" hidden>
          Could not load another set just now. Reload the page to see different packages.
        </p>
      </>
    ) : (
      <p class="text-gray-700">
        The package cache has not been built yet. Run <code class="bg-gray-100 px-1 rounded"
          >npm run refresh-data</code
        > to populate it.
      </p>
    )}

    <DataAttribution />
  </main>
</Layout>

<script
  define:vars={{
    sampleUrl: `${basePath}fund/sample${activeFilter ? `?flag=${activeFilter}` : ''}`,
  }}
>
  // "Show another set" swaps in a freshly sampled grid rendered by the server,
  // so the cards stay in one place (PackageCard.astro) rather than being
  // duplicated in client-side markup. The active filter travels with the request.
  const button = document.getElementById('reshuffle');
  const target = document.getElementById('package-set');
  const errorLine = document.getElementById('reshuffle-error');

  button?.addEventListener('click', async () => {
    button.disabled = true;
    errorLine.hidden = true;

    try {
      const res = await fetch(sampleUrl, { headers: { 'X-Requested-With': 'fetch' } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      target.innerHTML = await res.text();
    } catch {
      errorLine.hidden = false;
    } finally {
      button.disabled = false;
    }
  });
</script>
