---
/**
 * /fund/all — the complete cached set, alphabetical and paginated.
 *
 * Deliberately sorted by name and nothing else. Never by severity, never by
 * dependent count, and with no score or rank displayed: this is a list of
 * packages, not a ranking of who is worst off.
 */
import Layout from '../../components/Layout.astro';
import PackageGrid from '../../components/PackageGrid.astro';
import DataAttribution from '../../components/DataAttribution.astro';
import { getBasePath } from '../../lib/paths';
import {
  getAllPackagesAlphabetical,
  presentPackage,
  getPool,
  parseFilters,
  FILTERS,
} from '../../lib/critical-packages';

export const prerender = false;

const PER_PAGE = 60;
const basePath = getBasePath();

const active = parseFilters(Astro.url.searchParams.getAll('flag'));
const activeLabels = FILTERS.filter((f) => active.includes(f.id)).map((f) => f.label.toLowerCase());
const queryFor = (ids: string[]) => (ids.length ? ids.map((f) => `flag=${f}`).join('&') : '');

// Filter first, then sort by name. Never by severity, and never with a rank.
const filtered = new Set(getPool(active));
const all = getAllPackagesAlphabetical().filter((p) => filtered.has(p));
const totalPages = Math.max(1, Math.ceil(all.length / PER_PAGE));

const requestedPage = Number(Astro.url.searchParams.get('page') ?? '1');
const page = Number.isFinite(requestedPage)
  ? Math.min(Math.max(1, Math.trunc(requestedPage)), totalPages)
  : 1;

const start = (page - 1) * PER_PAGE;
const packages = all.slice(start, start + PER_PAGE).map(presentPackage);

const fmt = (n: number) => n.toLocaleString('en-US');
const pageHref = (n: number) => {
  const q = queryFor(active);
  return `${basePath}fund/all?page=${n}${q ? `&${q}` : ''}`;
};
const backHref = `${basePath}fund${active.length ? `?${queryFor(active)}` : ''}`;
---

<Layout
  title="Every package in the sample | OSS Wishlist"
  description="Every critical open source package in the cached sample, listed alphabetically."
>
  <main class="max-w-6xl mx-auto px-4 py-12">
    <nav class="mb-6">
      <a href={backHref} class="text-sm text-gray-600 hover:text-gray-900 underline"
        >&larr; Back to a random set</a
      >
    </nav>

    <h1 class="text-3xl font-bold text-gray-900 mb-3">Every package in the sample</h1>
    <p class="text-gray-700 mb-8">
      {fmt(all.length)} packages{activeLabels.length > 0
        ? ` with ${activeLabels.join(' and ')}`
        : ''}, listed alphabetically. Showing {fmt(start + 1)}&ndash;{fmt(
        start + packages.length
      )}.
    </p>

    <PackageGrid packages={packages} />

    {totalPages > 1 && (
      <nav class="flex items-center justify-between gap-4 mt-10" aria-label="Pagination">
        {page > 1 ? (
          <a
            href={pageHref(page - 1)}
            class="inline-block bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700 transition-colors text-sm font-medium"
            rel="prev">&larr; Previous</a
          >
        ) : (
          <span></span>
        )}

        <span class="text-sm text-gray-600">Page {fmt(page)} of {fmt(totalPages)}</span>

        {page < totalPages ? (
          <a
            href={pageHref(page + 1)}
            class="inline-block bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700 transition-colors text-sm font-medium"
            rel="next">Next &rarr;</a
          >
        ) : (
          <span></span>
        )}
      </nav>
    )}

    <DataAttribution />
  </main>
</Layout>
