---
/**
 * /invest — a three step wizard, adapted from the Teaching Open Source Risk and
 * Investment Framework (microsoft/OSPO).
 *
 *   1. Pick a package.
 *   2. Say what brings you here. We pre-tick from what the data shows and say
 *      why; you override freely.
 *   3. Choose how you would invest, and leave with a summary.
 *
 * It is a teaching tool as much as a picker, so the reasoning is on the page:
 * the evidence behind every suggestion, and the rubric each service is measured
 * against. Open Source Wishlist still brokers nothing. You go to the people
 * yourself.
 *
 * State lives entirely in the query string, so every step is linkable, the back
 * button works, and none of it needs JavaScript.
 */
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import PackageGrid from '../components/PackageGrid.astro';
import WizardSteps from '../components/WizardSteps.astro';
import DataAttribution from '../components/DataAttribution.astro';
import { getBasePath } from '../lib/paths';
import {
  getPackage,
  presentPackage,
  getFeaturedPackages,
  getEcosystemCounts,
  getHeadlinePool,
  samplePackages,
  searchPackages,
  countSearchMatches,
  isEcosystemId,
  packageKey,
  projectUrl,
  ECOSYSTEMS,
  type CriticalPackage,
} from '../lib/critical-packages';
import { getRubricForPlaybook } from '../lib/rubrics';
import { practitionersForServices } from '../lib/practitioner-availability';
import { checkRepositoryForPackage } from '../lib/dependency-check';
import {
  MOTIVATIONS,
  parseMotivations,
  servicesForMotivations,
  suggestedMotivations,
} from '../../config/motivations.js';
import { INVESTMENT_METHODS, parseMethods } from '../../config/investment-methods.js';
import { SAMPLE_SIZE } from '../../config/data-sources.js';

export const prerender = false;

const basePath = getBasePath();
const params = Astro.url.searchParams;
const fmt = (n: number) => n.toLocaleString('en-US');

// ---- Step 1 state: which package ----
const rawEcosystem = params.get('ecosystem');
const ecosystem = isEcosystemId(rawEcosystem) ? rawEcosystem : null;
const query = (params.get('q') ?? '').trim();
const searching = query.length >= 2;

const pkgEcosystem = params.get('pe');
const pkgName = params.get('pn');
const selected: CriticalPackage | undefined =
  pkgEcosystem && pkgName ? getPackage(pkgEcosystem, pkgName) : undefined;

// ---- Step 2 state: motivations ----
const chosenMotivations = parseMotivations(params.getAll('m'));
// `touched` separates "arrived with nothing chosen" from "deliberately cleared".
const motivationsSubmitted = params.get('ms') === '1';

// ---- Step 3 state: how to invest ----
const chosenMethods = parseMethods(params.getAll('method'));
const chosenPractitioners = params.getAll('p');
const methodsSubmitted = params.get('hs') === '1';

const step: 1 | 2 | 3 = !selected ? 1 : !motivationsSubmitted ? 2 : 3;

// ---- Step 1 content ----
const ecosystemCounts = getEcosystemCounts();
const featured = step === 1 && !ecosystem && !searching ? getFeaturedPackages() : [];
const searchResults = step === 1 && searching ? searchPackages(query, ecosystem) : [];
const searchTotal = step === 1 && searching ? countSearchMatches(query, ecosystem) : 0;
const browse =
  step === 1 && ecosystem && !searching
    ? samplePackages(SAMPLE_SIZE, getHeadlinePool(ecosystem))
    : [];

/** Link that selects a package and moves to step 2. */
const pickHref = (p: CriticalPackage) =>
  `${basePath}invest?pe=${encodeURIComponent(p.ecosystem)}&pn=${encodeURIComponent(p.name)}`;

// ---- Step 2 content ----
const evidence = selected ? suggestedMotivations(selected) : [];
const evidenceById = new Map(evidence.map((e) => [e.id, e.evidence]));
// First arrival is pre-ticked from evidence; after that, respect what was chosen.
const activeMotivations = motivationsSubmitted
  ? chosenMotivations
  : evidence.map((e) => e.id as string);

/**
 * Evidenced motivations lead, the rest follow in declared order.
 *
 * Ordered by evidence rather than by what is currently ticked, so unticking
 * something does not make it jump down the page while you are reading it.
 */
/** Advisories we can name and link, for the security evidence. */
const advisories = (selected?.advisories ?? []).filter((a) => a.url || a.id);

/** Always a link for the project name: repository, else its registry page. */
const selectedUrl = selected ? projectUrl(selected) : null;

/**
 * Optional: does one of your own repositories depend on this package?
 *
 * Asked in step 2 because it is evidence like any other. "You already depend on
 * this" is the strongest reason to care about it, and unlike the flags it is
 * about the visitor rather than the project. Nothing is stored.
 */
const submittedRepo = (params.get('repo') ?? '').trim();
const dependencyCheck =
  selected && submittedRepo
    ? await checkRepositoryForPackage(submittedRepo, selected.ecosystem, selected.name)
    : null;

const dependencyProblem =
  dependencyCheck && dependencyCheck.status !== 'ok'
    ? (dependencyCheck as Extract<typeof dependencyCheck, { message: string }>).message
    : null;

const orderedMotivations = [
  ...MOTIVATIONS.filter((m) => evidenceById.has(m.id)),
  ...MOTIVATIONS.filter((m) => !evidenceById.has(m.id)),
];

// ---- Step 3 content: services behind the chosen motivations ----
const catalog = await getCollection('services');
const slugOf = (entry: { id: string }) => entry.id.replace(/\.md$/, '');
const bySlug = new Map(catalog.map((e) => [slugOf(e), e]));

const serviceSlugs = servicesForMotivations(activeMotivations, selected) as string[];

// Who can actually do each of these. Empty when the database is unreachable or
// nobody has listed themselves, in which case the card renders no section at
// all rather than an empty one.
const matchedPractitioners = await practitionersForServices(serviceSlugs);
const practitionerCount = matchedPractitioners.length;

/** Service slug to title, for naming what a practitioner matched on. */
const serviceTitles = new Map(
  serviceSlugs.map((slug) => [slug, bySlug.get(slug)?.data.title ?? slug])
);
const services = await Promise.all(
  serviceSlugs
    .map((slug) => bySlug.get(slug))
    .filter((e): e is NonNullable<typeof e> => Boolean(e))
    .map(async (entry) => ({
      slug: slugOf(entry),
      data: entry.data,
      rubric: await getRubricForPlaybook(entry.data.playbook),
    }))
);

const selfBase = `${basePath}invest`;
const stepOneHref = selfBase;
const stepTwoHref = selected
  ? `${selfBase}?pe=${encodeURIComponent(selected.ecosystem)}&pn=${encodeURIComponent(selected.name)}`
  : null;

const title =
  step === 1
    ? 'Find a project to support'
    : step === 2
      ? `How do you want to help ${selected?.name}?`
      : `Supporting ${selected?.name}`;
---

<Layout title={`${title} | OSS Wishlist`} description="Work out what would help a critical open source package, and how to pay for it.">
  <main class="max-w-4xl mx-auto px-4 py-12">
    <div id="wizard">
    <WizardSteps current={step} packageHref={stepOneHref} motivationHref={stepTwoHref} />

    {step === 1 && (
      <>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Find a project to support</h1>
        <p class="text-gray-600 mb-1">Start with an open source project you already use.</p>
        <p class="text-xs text-gray-500 mb-5">
          Searchable via
          <a
            href="https://ecosyste.ms"
            class="underline hover:text-gray-700"
            rel="noopener noreferrer"
            target="_blank">ecosyste.ms</a
          >.
        </p>

        <form method="get" action={selfBase} class="mb-6" role="search">
          {ecosystem && <input type="hidden" name="ecosystem" value={ecosystem} />}
          <div class="flex flex-wrap gap-3">
            <input
              type="search"
              name="q"
              value={query}
              placeholder={ecosystem ? `Search ${ECOSYSTEMS.find((e) => e.id === ecosystem)?.label}` : 'Search by project name, e.g. lodash, requests, nokogiri'}
              aria-label="Search packages by name"
              autocomplete="off"
              class="flex-1 min-w-[16rem] border rounded px-4 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-purple-400"
            />
            <button type="submit" class="bg-gray-800 text-white px-5 py-2 rounded hover:bg-gray-700 transition-colors text-sm font-medium">
              Search
            </button>
          </div>
        </form>

        <div class="flex flex-wrap gap-2 mb-8" role="group" aria-label="Choose a package manager">
          {ECOSYSTEMS.filter((e) => ecosystemCounts[e.id] > 0).map((e) => (
            <a
              href={`${selfBase}?ecosystem=${e.id}`}
              aria-pressed={ecosystem === e.id ? 'true' : 'false'}
              class={`inline-flex items-baseline gap-2 rounded-full px-4 py-2 border transition-colors ${
                ecosystem === e.id
                  ? 'bg-gray-800 text-white border-gray-800'
                  : 'bg-white border-gray-300 hover:border-purple-400 hover:bg-purple-50'
              }`}
            >
              <span class="font-semibold">{e.label}</span>
              <span class={`text-xs ${ecosystem === e.id ? 'text-gray-300' : 'text-gray-500'}`}>{e.language}</span>
            </a>
          ))}
        </div>

        {searching && (
          searchResults.length > 0 ? (
            <>
              <h2 class="text-xl font-bold text-gray-900 mb-4">
                {searchTotal === 1 ? `1 match for "${query}"` : `${fmt(searchTotal)} matches for "${query}"`}
              </h2>
              <PackageGrid packages={searchResults.map(presentPackage).map((p) => ({ ...p, href: pickHref(p as any) }))} />
            </>
          ) : (
            <div class="bg-white border rounded-lg p-6">
              <h2 class="text-xl font-bold text-gray-900 mb-2">Nothing here matches &ldquo;{query}&rdquo;</h2>
              <p class="text-gray-700">
                We cache the most depended-on packages per registry, not every one.
                <a href="https://packages.ecosyste.ms/critical" class="underline hover:text-gray-900" rel="noopener noreferrer" target="_blank">Search the full list on ecosyste.ms &rarr;</a>
              </p>
            </div>
          )
        )}

        {!searching && browse.length > 0 && (
          <PackageGrid packages={browse.map(presentPackage).map((p) => ({ ...p, href: pickHref(p as any) }))} />
        )}

        {!searching && featured.length > 0 && (
          <>
            <h2 class="text-xl font-bold text-gray-900 mb-1">Or start with these</h2>
            <p class="text-gray-600 mb-6">Open source projects you have almost certainly used.</p>
            <PackageGrid packages={featured.map(presentPackage).map((p) => ({ ...p, href: pickHref(p as any) }))} />
          </>
        )}
      </>
    )}

    {step === 2 && selected && (
      <>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">
          How do you want to help{' '}
          {selectedUrl ? (
            <a
              href={selectedUrl}
              class="underline decoration-2 underline-offset-4 hover:text-purple-700"
              rel="noopener noreferrer"
              target="_blank"
              title={`Open ${selected.name}`}>{selected.name}</a
            >
          ) : (
            selected.name
          )}?
        </h1>
        <p class="text-gray-600 mb-8 max-w-2xl">
          Pre-selected services are those which Ecosyste.ms data indicates might be helpful.
        </p>

        <details class="mb-6 bg-white border rounded-lg p-5" open={Boolean(dependencyCheck || dependencyProblem)}>
          <summary class="cursor-pointer font-semibold text-gray-900 list-none inline-flex items-center gap-2">
            <span class="transition-transform" aria-hidden="true">&rsaquo;</span>
            Do you depend on {selected.name}?
          </summary>

          <form method="get" action={selfBase} class="mt-4">
            <input type="hidden" name="pe" value={selected.ecosystem} />
            <input type="hidden" name="pn" value={selected.name} />
            <div class="flex flex-wrap gap-3">
              <input
                type="search"
                name="repo"
                value={submittedRepo}
                placeholder="https://github.com/your-org/your-repo"
                aria-label={`Check whether a repository depends on ${selected.name}`}
                autocomplete="off"
                class="flex-1 min-w-[16rem] border rounded px-4 py-2 text-gray-900 focus:outline-none focus:ring-2 focus:ring-purple-400"
              />
              <button type="submit" class="bg-gray-800 text-white px-5 py-2 rounded hover:bg-gray-700 transition-colors text-sm font-medium">
                Check
              </button>
            </div>
            <p class="text-xs text-gray-500 mt-2">GitHub, GitLab and Codeberg. Public repositories only. Nothing is stored.</p>
          </form>

          {dependencyProblem && <p class="mt-4 text-gray-800">{dependencyProblem}</p>}

          {dependencyCheck?.status === 'ok' && (
            <div
              role="status"
              aria-live="polite"
              class={`mt-4 rounded-lg border-2 p-4 ${
                dependencyCheck.dependsOn
                  ? 'border-purple-500 bg-purple-50'
                  : 'border-gray-300 bg-gray-50'
              }`}
            >
              <p class={`text-2xl font-extrabold ${dependencyCheck.dependsOn ? 'text-purple-700' : 'text-gray-900'}`}>
                {dependencyCheck.dependsOn ? 'Yes' : 'No'}
              </p>
              <p class="text-gray-800 mt-1">
                {dependencyCheck.dependsOn ? (
                  <>
                    <span class="font-semibold">{dependencyCheck.repo.label}</span> depends on
                    <span class="font-semibold"> {selected.name}</span>.
                  </>
                ) : (
                  <>
                    We read {dependencyCheck.dependencyCount.toLocaleString('en-US')} dependencies
                    for <span class="font-semibold">{dependencyCheck.repo.label}</span> and
                    {' '}{selected.name} is not among them.
                  </>
                )}
              </p>
            </div>
          )}
        </details>

        <form method="get" action={selfBase}>
          <input type="hidden" name="pe" value={selected.ecosystem} />
          <input type="hidden" name="pn" value={selected.name} />
          <input type="hidden" name="ms" value="1" />

          <div class="space-y-3 mb-8">
            {orderedMotivations.map((m) => {
              const why = evidenceById.get(m.id);
              const checked = activeMotivations.includes(m.id);
              return (
                <label class={`flex gap-4 items-start p-5 rounded-lg border cursor-pointer transition-shadow hover:shadow-md ${why ? 'bg-purple-50 border-purple-200' : 'bg-white'}`}>
                  <input type="checkbox" name="m" value={m.id} checked={checked} class="mt-1 h-4 w-4 shrink-0" />
                  <span class="min-w-0">
                    <span class="block text-lg text-gray-900">
                      <span class="text-gray-500">I want to help with</span>{' '}
                      <span class="font-semibold">{m.label.toLowerCase()}</span>
                    </span>
                    <span class="block text-sm text-gray-600 mt-0.5">{m.question}</span>
                    {why && (
                      <span class="inline-block text-xs font-medium text-purple-800 bg-purple-100 border border-purple-200 rounded-full px-2 py-0.5 mt-2">
                        we see: {why}
                      </span>
                    )}

                    {/*
                      The security claim is the one with a public paper trail, so
                      show it rather than asking anyone to take the number on
                      trust. Same pattern as the rubrics: the evidence exists, and
                      here it is.
                    */}
                    {m.id === 'security' && advisories.length > 0 && (
                      <span class="block mt-2">
                        <details class="group">
                          <summary class="cursor-pointer text-xs text-gray-700 hover:text-gray-900 underline list-none inline-flex items-center gap-1">
                            <span class="transition-transform group-open:rotate-90" aria-hidden="true">&rsaquo;</span>
                            See the issues
                          </summary>
                          <span class="block mt-2 pl-3 border-l-2 border-purple-200 space-y-1">
                            {advisories.map((a) => (
                              <span class="block text-xs text-gray-700">
                                {a.severity && (
                                  <span class="uppercase text-gray-500 mr-1">{a.severity.toLowerCase()}</span>
                                )}
                                {a.url ? (
                                  <a
                                    href={a.url}
                                    class="underline hover:text-gray-900"
                                    rel="noopener noreferrer"
                                    target="_blank">{a.title ?? a.cve ?? a.id}</a
                                  >
                                ) : (
                                  a.title ?? a.cve ?? a.id
                                )}
                                {a.cve && <span class="text-gray-500"> &middot; {a.cve}</span>}
                              </span>
                            ))}
                          </span>
                        </details>
                      </span>
                    )}
                  </span>
                </label>
              );
            })}
          </div>

          <button type="submit" class="bg-purple-600 text-white px-7 py-3 rounded-lg hover:bg-purple-700 transition-colors font-semibold shadow-sm">
            Continue
          </button>
        </form>
      </>
    )}

    {step === 3 && selected && (
      <>
        <h1 class="text-3xl font-bold text-gray-900 mb-2">
          Supporting{' '}
          {selectedUrl ? (
            <a
              href={selectedUrl}
              class="underline decoration-2 underline-offset-4 hover:text-purple-700"
              rel="noopener noreferrer"
              target="_blank"
              title={`Open ${selected.name}`}>{selected.name}</a
            >
          ) : (
            selected.name
          )}
        </h1>

        {services.length > 0 ? (
          <>
            <p class="text-gray-600 mb-6 max-w-2xl">Here is a summary of your selections.</p>

            <ul class="space-y-2 mb-10">
              {services.map((s) => (
                <li class="bg-white border rounded-lg px-5 py-4 flex flex-wrap items-baseline justify-between gap-3">
                  <span class="text-lg font-semibold text-gray-900">{s.data.title}</span>
                  <a
                    href={`${basePath}services/${s.slug}`}
                    class="text-sm text-gray-600 hover:text-gray-900 underline"
                    >Full description &rarr;</a
                  >
                </li>
              ))}
            </ul>

          </>
        ) : (
          <p class="text-gray-700 mb-8">
            Nothing selected.
            <a href={stepTwoHref!} class="underline hover:text-gray-900">Go back and pick what brings you here</a>.
          </p>
        )}

        <form method="get" action={`${basePath}invest/plan`} id="plan-form">
          <input type="hidden" name="pe" value={selected.ecosystem} />
          <input type="hidden" name="pn" value={selected.name} />
          {activeMotivations.map((m) => <input type="hidden" name="m" value={m} />)}


          <h2 class="text-2xl font-bold text-gray-900 mb-2">How would you like to invest?</h2>

          <div class="space-y-3 mb-6">
            {INVESTMENT_METHODS.map((m) => (
              <div class="method-block">
                <label class="flex gap-4 items-start bg-white p-5 rounded-lg border cursor-pointer hover:shadow-md transition-shadow">
                  <input type="checkbox" name="method" value={m.id} checked={chosenMethods.includes(m.id)} class="mt-1 h-4 w-4 shrink-0" />
                  <span class="min-w-0">
                    <span class="block text-lg font-semibold text-gray-900">{m.label}</span>
                    <span class="block text-sm text-gray-600 mt-0.5">{m.summary}</span>
                    {m.id === 'practitioner' && practitionerCount > 0 && (
                      <span class="block text-xs text-gray-700 mt-1">
                        {practitionerCount === 1
                          ? '1 practitioner listed for this work'
                          : `${practitionerCount} practitioners listed for this work`}
                      </span>
                    )}
                    {m.caveat && m.caveatWhen(selected) && (
                      <span class="block text-xs text-gray-700 bg-gray-100 border rounded px-2 py-1 mt-2">{m.caveat}</span>
                    )}
                  </span>
                </label>

                {/*
                  The practitioner list is only relevant once you have said you
                  would pay someone. Revealed by CSS when the option above is
                  ticked, and rendered visible when it arrives already ticked, so
                  it works with JavaScript off too.
                */}
                {m.id === 'practitioner' && matchedPractitioners.length > 0 && (
                  <div class="practitioner-picker mt-3 ml-8 pl-4 border-l-2 border-purple-200">
                    <p class="text-sm font-semibold text-gray-800 mb-1">Practitioners with this speciality</p>
                    <p class="text-sm text-gray-600 mb-4">They listed these services themselves. Pick any, or none.</p>

                    <ul class="space-y-3">
                      {matchedPractitioners.map((person) => (
                        <li>
                          <label class="bg-white border rounded-lg p-4 flex gap-4 cursor-pointer hover:shadow-md transition-shadow">
                            <input type="checkbox" name="p" value={person.slug} checked={chosenPractitioners.includes(person.slug)} class="mt-1 h-4 w-4 shrink-0" />

                            {person.avatar_url ? (
                              <img src={person.avatar_url} alt="" width="40" height="40" loading="lazy" class="w-10 h-10 rounded-full object-cover shrink-0" />
                            ) : (
                              <span class="w-10 h-10 rounded-full bg-gray-200 shrink-0"></span>
                            )}

                            <span class="min-w-0">
                              <span class="block font-semibold text-gray-900">
                                {person.name}
                                {person.accepts_pro_bono && (
                                  <span class="ml-2 text-xs font-medium text-gray-700 bg-gray-100 border border-gray-200 rounded-full px-2 py-0.5">pro bono</span>
                                )}
                                {person.availability === 'limited' && (
                                  <span class="ml-2 text-xs font-medium text-gray-600">limited availability</span>
                                )}
                              </span>
                              {person.title && <span class="block text-sm text-gray-600">{person.title}</span>}
                              {person.bio && <span class="block text-sm text-gray-700 mt-1 line-clamp-2">{person.bio}</span>}
                              <span class="block text-xs text-gray-600 mt-2">
                                Covers {person.matched.map((x) => serviceTitles.get(x) ?? x).join(', ')}
                              </span>
                            </span>
                          </label>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            ))}
          </div>

          <button type="submit" class="bg-purple-600 text-white px-7 py-3 rounded-lg hover:bg-purple-700 transition-colors font-semibold shadow-sm">
            Create the plan
          </button>
        </form>

      </>
    )}

    </div>

    <DataAttribution />
  </main>
</Layout>

<style>
  /*
   * The practitioner list belongs to the "pay a practitioner" option, so it
   * only appears once that option is ticked. Done in CSS rather than script so
   * it responds instantly and still works with JavaScript disabled: the server
   * renders the option already ticked when it arrives that way, and :has()
   * handles it from there.
   */
  .practitioner-picker {
    display: none;
  }

  .method-block:has(input[name='method']:checked) .practitioner-picker {
    display: block;
  }

  /* Without :has(), show it rather than hiding a choice someone cannot reach. */
  @supports not selector(:has(*)) {
    .practitioner-picker {
      display: block;
    }
  }
</style>

<script>
  /**
   * Swap wizard steps in place instead of reloading the page.
   *
   * Progressive enhancement: the forms and links are ordinary GET forms and
   * hrefs, so the wizard works with this script disabled. All this does is
   * fetch the same URL the browser would have navigated to and replace the
   * wizard body, which keeps the server as the single source of truth for what
   * each step contains.
   *
   * Listeners are delegated from document, so nothing needs rebinding after a
   * swap, which matters because inline scripts inside swapped HTML never run.
   */
  const WIZARD = '#wizard';

  async function swapTo(url, { push = true } = {}) {
    const wizard = document.querySelector(WIZARD);
    if (!wizard) return;

    wizard.setAttribute('aria-busy', 'true');
    wizard.style.opacity = '0.6';

    try {
      const res = await fetch(url, { headers: { 'X-Requested-With': 'fetch' } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);

      const html = await res.text();
      const next = new DOMParser().parseFromString(html, 'text/html').querySelector(WIZARD);
      if (!next) throw new Error('no wizard in response');

      wizard.innerHTML = next.innerHTML;
      if (push) history.pushState({}, '', url);

      // Land at the top of the step that just arrived, not wherever the last
      // one was scrolled to.
      const heading = wizard.querySelector('h1');
      if (heading) heading.scrollIntoView({ block: 'start', behavior: 'smooth' });
      else window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch {
      // Fall back to a normal navigation rather than leaving a dead button.
      window.location.href = url;
    } finally {
      wizard.removeAttribute('aria-busy');
      wizard.style.opacity = '';
    }
  }

  const inWizard = (el) => el && el.closest(WIZARD);

  document.addEventListener('click', (event) => {
    const link = event.target.closest?.('a');
    if (!link || !inWizard(link) || link.target === '_blank') return;

    const url = new URL(link.href, window.location.origin);
    // Only intercept our own wizard links; anything else navigates normally.
    if (url.origin !== window.location.origin || !url.pathname.endsWith('/invest')) return;

    event.preventDefault();
    swapTo(url.pathname + url.search);
  });

  document.addEventListener('submit', (event) => {
    const form = event.target;
    if (!inWizard(form)) return;

    // Read the attributes, not the properties. A control named "method" or
    // "action" shadows the form property of the same name, and step 3 has
    // checkboxes named "method", so form.method is a RadioNodeList there.
    const method = (form.getAttribute('method') || 'get').toLowerCase();
    if (method !== 'get') return;

    const action = new URL(form.getAttribute('action') || window.location.pathname, window.location.origin);

    // The plan is a different page, not another step. Let the browser navigate
    // rather than fetching it, failing to find #wizard and falling back.
    if (!action.pathname.endsWith('/invest')) return;

    event.preventDefault();
    const params = new URLSearchParams(new FormData(form));
    swapTo(`${action.pathname}?${params.toString()}`);
  });

  // Back and forward should move through the wizard, not out of it.
  window.addEventListener('popstate', () => {
    swapTo(window.location.pathname + window.location.search, { push: false });
  });

</script>
