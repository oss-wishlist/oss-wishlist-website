---
/**
 * /playbooks/:folder — kept only to forward to the service page.
 *
 * There were two pages rendering the same markdown. The service page renders
 * the whole playbook, all eighteen headings of it, and surrounds it with what
 * makes it useful: what the service is, what it costs, the rubric it is
 * assessed against, and the practitioners who cover it. This route rendered
 * the same text with none of that, was reachable only from a link at the
 * bottom of the page it duplicated, and returned a 502 to everyone until the
 * commit before this one.
 *
 * So the service page is where a playbook is read, and this forwards to it.
 * A redirect rather than a deletion, because the URLs are in the wild: the
 * sitemap listed them and search engines have them indexed. /playbooks already
 * forwards to /catalog, so this does what its parent does.
 */
import { getCollection } from 'astro:content';
import { getBasePath } from '../../lib/paths';
import { playbookFolder } from '../../lib/playbook-title';

export const prerender = false;

const basePath = getBasePath();
const { slug } = Astro.params;
const requested = playbookFolder(Array.isArray(slug) ? slug.join('/') : slug || '');

/** The service that declares this playbook, by either frontmatter field. */
const services = await getCollection('services');
const owner = services.find((service) => {
  const declared = Array.isArray(service.data.playbooks)
    ? service.data.playbooks
    : service.data.playbook
      ? [service.data.playbook]
      : [];
  return declared.includes(requested);
});

// Nothing claims it, so the catalogue rather than nowhere.
const target = owner
  ? `${basePath}services/${owner.id.replace(/\.md$/, '')}`
  : `${basePath}catalog`;

return Astro.redirect(target, 301);
---
