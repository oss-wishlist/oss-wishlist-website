---
import Layout from '../components/Layout.astro';
import PlaceholderPage from '../components/PlaceholderPage.astro';
import { getCollection } from 'astro:content';
import { getBasePath } from '../lib/paths';
export const prerender = false;

// Check if site is in placeholder mode
const basePath = getBasePath();
const siteMode = import.meta.env.PUBLIC_SITE_MODE || 'full';
const isPlaceholder = siteMode === 'placeholder';

const services = await getCollection('services');

const featuredServices = [] as typeof services;
const maintainerServices = services.filter(service => 
  service.data.target_audience === 'maintainer' || service.data.target_audience === 'both'
);
const companyServices = services.filter(service => 
  service.data.target_audience === 'company' || service.data.target_audience === 'both'
);
---

<Layout 
  title="Open Source Wishlist | Expert Help for Open Source Sustainability" 
  description="Open Source Wishlist connects open source maintainers with expert practitioners for sustainability: governance, funding strategy, security audits, succession planning, and more.">
  {isPlaceholder ? (
    <PlaceholderPage />
  ) : (
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-gray-50 to-gray-100 py-12 pb-8" aria-labelledby="hero-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="max-w-4xl mx-auto">
        <h1 id="hero-heading" class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-950 mb-4">
          Open Source <span class="text-accent">Wishlist</span>
        </h1>
        <p class="text-base md:text-lg lg:text-xl text-gray-700 mb-3">
          Finding the projects that need help is easy. We know how to resolve most
          sustainability issues. The expertise is available right now.
        </p>
        <p class="text-lg md:text-xl font-semibold text-gray-900 mb-8">
          What are you waiting for?
        </p>
        
        <!-- One door -->
        <div class="max-w-md mx-auto mb-8" role="list">
          <article
            class="relative bg-white p-6 md:p-8 rounded-xl shadow-lg hover:shadow-xl transition-shadow border border-purple-200 ring-1 ring-purple-100 flex flex-col"
            role="listitem"
          >
            <span
              class="absolute inset-x-0 top-0 h-1 rounded-t-xl bg-gradient-to-r from-purple-500 to-violet-500"
              aria-hidden="true"
            ></span>
            <h2 class="text-2xl font-semibold text-purple-700 mb-2">Find a project to support</h2>
            <p class="text-gray-700 mb-2 flex-grow">
              Start with an open source project you already use.
            </p>
            <p class="text-xs text-gray-500 mb-5">
              Search covers the
              <a
                href="https://packages.ecosyste.ms/critical"
                class="underline hover:text-gray-700"
                rel="noopener noreferrer"
                target="_blank">ecosyste.ms critical packages</a
              > dataset, not every package published.
            </p>
            <a
              href={`${basePath}invest`}
              class="btn-sparkle w-full"
              aria-label="Find a project to support"
            >
              <svg class="btn-sparkle-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
              </svg>
              <span class="btn-sparkle-text">Get started</span>
              <span class="btn-sparkle-particles">
                <span class="sparkle-particle" style="top: 50%; left: 25%; background-color: rgb(196, 181, 253);"></span>
                <span class="sparkle-particle" style="top: 25%; right: 33%; background-color: rgb(167, 139, 250); animation-delay: 0.1s;"></span>
                <span class="sparkle-particle" style="bottom: 33%; right: 25%; background-color: rgb(217, 213, 254); animation-delay: 0.2s;"></span>
              </span>
            </a>
          </article>

          <!--
            Said before the click, not after it. Someone arriving on the home
            page is deciding whether this site does the thing they came for,
            and the honest answer shapes what they expect from the wizard.
          -->
          <p class="text-sm text-gray-600 mt-5 text-center" role="note">
            OSS Wishlist is a teaching tool. It shows you what would help a project and who
            works on that kind of problem. It does not sell, provide or broker any of it.
          </p>
        </div>

      </div>
    </section>

        </div>
      </div>
    </div>
  </section>
  )}
</Layout>
```