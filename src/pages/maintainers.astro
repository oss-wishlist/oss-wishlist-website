---
/**
 * /maintainers — the services available to people maintaining a project.
 *
 * This was previously "My Wishlists" and required a login to see anything. It
 * now shows the maintainer-facing half of the catalog, which needs no account:
 * the services already carry their own descriptions, outcomes and practitioners.
 */
import Layout from '../components/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { getCollection } from 'astro:content';
import { getBasePath } from '../lib/paths';
import { withSlug } from '../lib/entry-slug';

const basePath = getBasePath();

const services = (await getCollection('services')).map(withSlug);
const maintainerServices = services.filter(
  (service) =>
    service.data.target_audience === 'maintainer' || service.data.target_audience === 'both'
);
---

<Layout
  title="Services for Open Source Maintainers - OSS Wishlist"
  description="Practitioner services to help open source maintainers scale projects, build communities, and create sustainable funding."
>
  <section class="bg-gray-50 py-12" id="hero-section">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-5xl font-bold text-gray-900 mb-4" id="page-title">
          Support for <span class="text-accent">maintainers</span>
        </h1>
        <p class="text-gray-600 text-base">
          Work that other people can take off your plate: governance, funding, security,
          succession, release load. Each one has practitioners who do it.
        </p>
      </div>
    </div>
  </section>

  {maintainerServices.length > 0 && (
    <section class="py-12 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {maintainerServices.map((service) => (
            <ServiceCard
              title={service.data.title}
              description={service.data.description}
              slug={service.slug}
              type={service.data.type}
              available={service.data.available}
              unavailable_reason={service.data.unavailable_reason}
              impact={service.data.impact}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-12 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Looking for a package to support?</h2>
        <p class="text-gray-600 text-base mb-8">
          Browse critical packages and the services that might help them, or check which ones
          your own project already depends on.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href={`${basePath}fund`}
            class="inline-block bg-gray-600 text-white px-5 py-2 rounded hover:bg-gray-700 transition-colors text-sm font-medium"
            >Browse packages</a
          >
          <a
            href={`${basePath}check`}
            class="inline-block border border-gray-400 text-gray-700 px-5 py-2 rounded hover:bg-gray-100 transition-colors text-sm font-medium"
            >Check your dependencies</a
          >
        </div>
      </div>
    </div>
  </section>
</Layout>
