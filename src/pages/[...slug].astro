---
import { getEntry, render } from 'astro:content';
import Layout from '../components/Layout.astro';
import { getBasePath } from '../lib/paths';

export const prerender = false;

// Server-rendered: resolve content dynamically at request time.
const { slug } = Astro.params;
const pageSlug = Array.isArray(slug) ? slug.join('/') : slug || '';

/*
  This route catches every URL that nothing else matched, which in practice
  means a lot of scanner traffic: /.git/config, /.env, /wp-login.php. Handing
  those straight to getEntry made the content layer log "Entry pages -> .git/
  config was not found" for each one, which is how they turned up in the
  production logs.

  Content page slugs are lowercase words, digits and hyphens, optionally nested
  one locale deep. Anything else cannot name a page, so it does not need to be
  looked up.
*/
const LOOKS_LIKE_A_PAGE = /^[a-z0-9]+(?:-[a-z0-9]+)*(?:\/[a-z0-9]+(?:-[a-z0-9]+)*)?$/;

const page = LOOKS_LIKE_A_PAGE.test(pageSlug) ? await getEntry('pages', pageSlug) : undefined;
if (!page) {
  return Astro.redirect(`${getBasePath()}404`);
}
const { Content } = await render(page);
const basePath = getBasePath();
---

<Layout 
  title={`${page.data.title} - OSS Wishlist`} 
  description={page.data.description || page.data.title}
>
  <article class="py-16" data-page={pageSlug}>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Date only (title is in content) -->
      {page.data.date && (
        <div class="mb-8">
          <p class="text-sm text-gray-500">
            Last updated: {new Date(page.data.date).toLocaleDateString('en-US', { 
              year: 'numeric', 
              month: 'long', 
              day: 'numeric' 
            })}
          </p>
        </div>
      )}

      <!-- Content -->
      <div class="prose prose-lg prose-gray max-w-none">
        <Content />
      </div>

      <!-- Footer Actions -->
      <div class="mt-12 pt-8 border-t border-gray-200">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div></div>
          <a 
            href={`${basePath}/`}
            class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-gray-900"
          >
            ← Back to Home
          </a>
        </div>
      </div>
    </div>
  </article>
</Layout>
