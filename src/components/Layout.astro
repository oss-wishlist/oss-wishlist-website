---
import '../styles/global.css';
import { getBasePath } from '../lib/paths';
import Header from './Header.astro';

export interface Props {
  title: string;
  description?: string;
  showHeader?: boolean;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { 
  title, 
  description = "Open Source Wishlist is a teaching tool. It uses ecosyste.ms data to show what would help a critical open source project, and which kinds of expertise address it.",
  
  showHeader = true,
  image = '/logo.png',
  type = 'website',
  noindex = false
} = Astro.props as Props;

// Use centralized path utility for consistent handling
const basePath = getBasePath(); // Returns with trailing slash
const logoUrl = '/logo.png';

// Build canonical URL
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://oss-wishlist.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

// Full image URL for Open Graph
const ogImage = image.startsWith('http') ? image : new URL(image, siteUrl).toString();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Robots -->
    {(import.meta.env.DISABLE_INDEXING === 'true' || noindex) && (
      <meta name="robots" content="noindex, nofollow" />
    )}
    {!(import.meta.env.DISABLE_INDEXING === 'true' || noindex) && (
      <meta name="robots" content="index, follow" />
    )}
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Open Source Wishlist" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    
    <!-- Favicons -->
    <link rel="icon" type="image/png" href={logoUrl} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    
    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />
    
    <!-- Structured Data for Organization -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Open Source Wishlist",
        "url": "https://oss-wishlist.com",
        "logo": "https://oss-wishlist.com/logo.png",
        "description": "Open Source Wishlist is a teaching tool. It uses ecosyste.ms data to show what would help a critical open source project, and which kinds of expertise address it.",
        "sameAs": [
          "https://github.com/oss-wishlist",
          "https://www.linkedin.com/company/110187652"
        ]
      }
    </script>
  </head>
  <body class="bg-gray-50 min-h-screen overflow-x-hidden flex flex-col">
    <!-- Skip to main content link for keyboard users -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-gray-900 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg">
      Skip to main content
    </a>

  {showHeader && <Header />}

    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
    </main>

    <footer class="bg-gray-900 text-white py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <div class="flex flex-col sm:flex-row justify-center gap-4 sm:gap-6 flex-wrap">
            <a 
              href="https://github.com/oss-wishlist" 
              class="text-gray-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-gray-900 rounded px-2 py-1 flex items-center justify-center sm:justify-start min-h-[44px] transition-colors"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Visit our GitHub repository"
            >
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd" />
              </svg>
              <span class="hidden sm:inline">GitHub</span>
            </a>
            <a 
              href={`${basePath}privacy-policy`}
              class="text-gray-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-gray-900 rounded px-2 py-1 flex items-center justify-center sm:justify-start min-h-[44px] transition-colors"
              aria-label="Read our Privacy Policy"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <span class="hidden sm:inline">Privacy Policy</span>
            </a>
            <a
              href="https://github.com/sponsors/emmairwin"
              class="text-gray-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-gray-900 rounded px-2 py-1 flex items-center justify-center sm:justify-start min-h-[44px] transition-colors"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Fund this work on GitHub Sponsors"
            >
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" />
              </svg>
              <span class="hidden sm:inline">Fund this work</span>
            </a>
            <a
              href="https://github.com/oss-wishlist/oss-wishlist-website/issues/new"
              class="text-gray-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-gray-900 rounded px-2 py-1 flex items-center justify-center sm:justify-start min-h-[44px] transition-colors"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="File a bug on GitHub"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
              </svg>
              <span class="hidden sm:inline">File a bug</span>
            </a>
            <a 
              href={`${basePath}contact`}
              class="text-gray-400 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-gray-900 rounded px-2 py-1 flex items-center justify-center sm:justify-start min-h-[44px] transition-colors"
              aria-label="Contact Us"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span class="hidden sm:inline">Contact Us</span>
            </a>
          </div>

          <!--
            What the site is, said once, in the one place that is on every page.
            It belongs here rather than on each surface because it is a standing
            fact about the project, not a caveat about any particular screen.
          -->
          <p class="mt-8 pt-6 border-t border-gray-800 text-sm text-gray-400">
            OSS Wishlist is a teaching tool.
          </p>
        </div>

      </div>
    </footer>

    <!-- Default Statcounter code for OSS Wishlist https://oss-wishlist.com/ -->
    <script is:inline type="text/javascript">
      var sc_project=13182009; 
      var sc_invisible=1; 
      var sc_security="ea9ced02"; 
    </script>
    <script is:inline type="text/javascript" src="https://www.statcounter.com/counter/counter.js" async></script>
    <noscript>
      <div class="statcounter">
        <a title="Web Analytics Made Easy - Statcounter" href="https://statcounter.com/" target="_blank">
          <img class="statcounter" src="https://c.statcounter.com/13182009/0/ea9ced02/1/" alt="Web Analytics Made Easy - Statcounter" referrerPolicy="no-referrer-when-downgrade">
        </a>
      </div>
    </noscript>
    <!-- End of Statcounter Code -->
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  
  body {
    font-family: system-ui, sans-serif;
  }
  
  /* Screen reader only class */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
  
  /* Make sr-only visible on focus */
  .focus\:not-sr-only:focus {
    position: static;
    width: auto;
    height: auto;
    padding: inherit;
    margin: inherit;
    overflow: visible;
    clip: auto;
    white-space: normal;
  }
  
  /* Enhanced focus visible for all interactive elements */
  *:focus-visible {
    outline: 2px solid #3B82F6;
    outline-offset: 2px;
  }
  
  /* Better focus for buttons and links */
  button:focus-visible,
  a:focus-visible {
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.5);
  }
</style>