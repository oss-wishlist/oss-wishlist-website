---
/**
 * Where you are in the wizard. Three steps, and you can go back to any you have
 * already passed.
 *
 * Deliberately just numbers and short labels: the step you are on should be
 * obvious at a glance without being read.
 */
export interface Props {
  current: 1 | 2 | 3;
  packageHref?: string | null;
  motivationHref?: string | null;
}

const { current, packageHref = null, motivationHref = null } = Astro.props as Props;

/*
  Each step has its own colour, so the page you are on is recognisable before
  you read anything. Step 2 is purple, step 3 teal. Teal differs from purple in
  lightness as well as hue, so the two stay apart for red-green colour vision.
*/
const ACCENT = {
  1: 'bg-gray-800 text-white',
  2: 'bg-purple-600 text-white',
  3: 'bg-teal-700 text-white',
} as const;

const steps = [
  { n: 1, label: 'Pick a project', href: current > 1 ? packageHref : null },
  { n: 2, label: 'How to help', href: current > 2 ? motivationHref : null },
  { n: 3, label: 'How to invest', href: null },
] as const;
---

<nav class="mb-8" aria-label="Progress">
  <ol class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
    {steps.map((step, i) => (
      <li class="flex items-center gap-3">
        {i > 0 && <span class="text-gray-300" aria-hidden="true">&rarr;</span>}
        <span class="flex items-center gap-2">
          <span
            class={`flex items-center justify-center w-6 h-6 rounded-full text-xs font-bold ${
              step.n === current
                ? ACCENT[step.n]
                : step.n < current
                  ? 'bg-gray-800 text-white'
                  : 'bg-gray-200 text-gray-500'
            }`}
            aria-hidden="true">{step.n}</span
          >
          {step.href ? (
            <a href={step.href} class="text-gray-700 hover:text-gray-900 underline"
              >{step.label}</a
            >
          ) : (
            <span
              class={step.n === current ? 'font-semibold text-gray-900' : 'text-gray-500'}
              aria-current={step.n === current ? 'step' : undefined}>{step.label}</span
            >
          )}
        </span>
      </li>
    ))}
  </ol>
</nav>
